--========================================================
-- CHARACTER
--========================================================

local function Character()
	return LP.Character
end

local function Humanoid()
	local c = Character()
	return c and c:FindFirstChildOfClass("Humanoid")
end

local function Root()
	local c = Character()
	return c and c:FindFirstChild("HumanoidRootPart")
end

local function ApplyCharacter()
	local h = Humanoid()
	if not h then return end

	h.WalkSpeed = Speed
	h.JumpPower = Jump

	h:SetAttribute("NoStun", NoStun)
	h:SetAttribute("NoKnockback", NoKnockback)

	if GodMode and h.Health > 0 then
		h.Health = h.MaxHealth
	end
end

LP.CharacterAdded:Connect(function()
	task.wait(0.5)
	ApplyCharacter()
end)

