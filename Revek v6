local function ClearContent()
	for _,v in ipairs(Content:GetChildren()) do
		if not v:IsA("UIListLayout")
		and not v:IsA("UIPadding") then
			v:Destroy()
		end
	end
	Content.CanvasPosition = Vector2.zero
end

local function HeaderText(text)
	local L = Instance.new("TextLabel")
	L.Size = UDim2.new(1,0,0,38)
	L.BackgroundTransparency = 1
	L.Text = text
	L.TextColor3 = Color3.fromRGB(225,220,255)
	L.TextSize = 19
	L.Font = Enum.Font.GothamBold
	L.TextXAlignment = Enum.TextXAlignment.Left
	L.Parent = Content
	return L
end

local function Button(text,callback)
	local B = Instance.new("TextButton")

	B.Size = UDim2.new(1,0,0,44)
	B.BackgroundColor3 = Color3.fromRGB(27,32,47)
	B.BorderSizePixel = 0
	B.Text = text
	B.TextColor3 = Color3.fromRGB(235,238,250)
	B.TextSize = 14
	B.Font = Enum.Font.GothamMedium
	B.AutoButtonColor = true
	B.Active = true
	B.Selectable = true
	B.Parent = Content

	Instance.new("UICorner",B).CornerRadius = UDim.new(0,9)

	B.Activated:Connect(function()
		local ok,err = pcall(callback)
		if not ok then
			warn("[Revek]",err)
		end
	end)

	return B
end

local function Category(name,icon,callback)
	local B = Instance.new("TextButton")

	B.Size = UDim2.new(1,-3,0,43)
	B.BackgroundColor3 = Color3.fromRGB(22,28,43)
	B.BorderSizePixel = 0
	B.Text = icon.."  "..name
	B.TextColor3 = Color3.fromRGB(220,225,245)
	B.TextSize = 13
	B.Font = Enum.Font.GothamMedium
	B.TextXAlignment = Enum.TextXAlignment.Left
	B.AutoButtonColor = true
	B.Active = true
	B.Selectable = true
	B.Parent = Side

	local P = Instance.new("UIPadding")
	P.PaddingLeft = UDim.new(0,10)
	P.Parent = B

	Instance.new("UICorner",B).CornerRadius = UDim.new(0,9)

	B.Activated:Connect(callback)

	return B
end

