local function MovementPage()
	ClearContent()
	HeaderText("🏃  Movement")

	Button("✈️ Fly : "..(Flying and "ON" or "OFF"),function()
		Flying = not Flying
		if not Flying then
			local r = Root()
			if r then
				r.AssemblyLinearVelocity = Vector3.zero
			end
		end
		MovementPage()
	end)

	Button("🚀 Fly Speed +10  ("..FlySpeed..")",function()
		FlySpeed = math.clamp(FlySpeed+10,10,500)
		MovementPage()
	end)

	Button("🐢 Fly Speed -10",function()
		FlySpeed = math.clamp(FlySpeed-10,10,500)
		MovementPage()
	end)

	Button("💨 Dash",function()
		local r = Root()
		if r then
			r.AssemblyLinearVelocity =
				r.CFrame.LookVector * 100
		end
	end)

	Button("➡️ Teleport Forward",function()
		local r = Root()
		if r then
			r.CFrame = r.CFrame + r.CFrame.LookVector*25
		end
	end)

	Button("⬆️ Up 20",function()
		local r = Root()
		if r then
			r.CFrame = r.CFrame + Vector3.new(0,20,0)
		end
	end)

	Button("⬇️ Down 20",function()
		local r = Root()
		if r then
			r.CFrame = r.CFrame - Vector3.new(0,20,0)
		end
	end)
end

