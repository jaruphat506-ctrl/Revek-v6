--========================================================
-- TARGET
--========================================================

local function TargetPage()
	ClearContent()
	HeaderText("🎯  Target")

	Button("🎯 Teleport Nearest Player",function()
		local r = Root()
		if not r then return end

		local nearest
		local dist = math.huge

		for _,p in ipairs(Players:GetPlayers()) do
			if p ~= LP and p.Character then
				local pr = p.Character:FindFirstChild("HumanoidRootPart")
				if pr then
					local d = (pr.Position-r.Position).Magnitude
					if d < dist then
						dist = d
						nearest = pr
					end
				end
			end
		end

		if nearest then
			r.CFrame = nearest.CFrame + Vector3.new(0,3,0)
		end
	end)

	Button("👥 Player List",function()
		for _,p in ipairs(Players:GetPlayers()) do
			print(p.Name)
		end
	end)
end

